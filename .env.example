# Base URL of the CKD prediction API (no trailing slash).
# Local dev:      http://localhost:8000
# Render (live):  https://kidney-guard-1.onrender.com
#
# In Vercel, set this as an Environment Variable named NEXT_PUBLIC_CKD_API_URL.
# NEXT_PUBLIC_* vars are baked in at build time, so redeploy after changing it.
NEXT_PUBLIC_CKD_API_URL=http://localhost:8000

# ── Supabase (authentication + prediction history) ──────────────────────────
# Create a free project at https://supabase.com, then Project Settings → API.
# Add BOTH of these in Vercel too. Until they are set, auth stays disabled and
# the app runs without login. See SUPABASE_SETUP.md for full steps.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
