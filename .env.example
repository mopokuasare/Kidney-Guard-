# ── Frontend (Next.js / Vercel) ──────────────────────────────────
# Base URL of the FastAPI service. No trailing slash.
# Local:      http://localhost:8000
# Production: https://kidney-guard-api.onrender.com
NEXT_PUBLIC_CKD_API_URL=http://localhost:8000

# Supabase (auth + prediction history)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Backend (FastAPI / Render) ───────────────────────────────────
# Comma-separated allowed origins. Required for credentialed requests:
# browsers reject wildcard CORS when credentials are sent.
# Leave unset for open, credential-free access.
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Set to 0 to skip loading the SHAP explainer (saves ~33 MB RSS).
ENABLE_SHAP=1
